# =============================================================================
# Debate-AI — Environment Variables
# Copy to .env and fill in your keys.
# =============================================================================

# LLM Keys (at least one required for agent functionality)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional API Keys
GOOGLE_FACTCHECK_API_KEY=
NEWSAPI_KEY=
HF_TOKEN=

# Database & Cache (defaults work for docker-compose; override for local dev)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/debate_ai
REDIS_URL=redis://redis:6379/0
